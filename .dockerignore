.git
.gitignore
.gitattributes

# Dependências: reinstaladas dentro da imagem
node_modules
vendor

# Build local do Vite: refeito na etapa de assets
public/build
public/hot

# Ambiente e banco locais nunca vão para a imagem.
# Regra ampla: .env.local, .env.staging e afins também carregam segredos.
.env
.env.*
*.sqlite
*.sqlite-journal
*.sql
*.dump

# Chaves e certificados jamais entram na imagem
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*

# Cache e logs locais
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*
.phpunit.result.cache
.phpunit.cache

# Coisas de desenvolvimento
tests
phpunit.xml
.editorconfig
.vscode
.idea
README.md
DEPLOY.md
CLAUDE.md

APP_NAME="Contador de Carregamento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
# Fallback em inglês: chave sem tradução mostra o texto padrão do Laravel,
# nunca a chave crua como "validation.required"
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desenvolvimento usa SQLite; produção usa MySQL (veja DEPLOY.md)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=carregamento
# DB_USERNAME=carregamento
# DB_PASSWORD=

SESSION_DRIVER=database
# 60 dias — o operador marca "manter conectado" e não deve ser deslogado no meio do turno
SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção sob HTTPS, mude para true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# O sistema não envia e-mail: o acesso é por código de usuário
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
